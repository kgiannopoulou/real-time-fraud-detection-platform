# Copy to .env and adjust. Every value has a sensible default in code.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
TRANSACTIONS_TOPIC=transactions

# Transaction generator
GENERATOR_RATE=20
GENERATOR_SEED=42   # fixes the card-holder population; events are random per run

# MLflow tracking server (docker compose up -d mlflow)
MLFLOW_TRACKING_URI=http://localhost:5000
FRAUD_PREDICTIONS_TOPIC=fraud_predictions

# Spark streaming
WATERMARK_DELAY=2 minutes
ALLOWED_LATENESS_SECONDS=120
TRIGGER_INTERVAL=2 seconds
MODEL_ALIAS=champion
MODEL_REFRESH_SECONDS=60

# PostgreSQL serving store (host port 5436)
POSTGRES_DSN=postgresql://fraud:fraud_local_pw@localhost:5436/fraud
FRAUD_ALERTS_TOPIC=fraud_alerts
DEAD_LETTER_TOPIC=dead_letter_transactions
