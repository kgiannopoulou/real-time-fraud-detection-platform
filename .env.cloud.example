# Example configuration for AWS (values come from Terraform outputs and
# Secrets Manager). The same images run locally and in the cloud.

# Amazon MSK (SASL/SCRAM over TLS)
KAFKA_BOOTSTRAP_SERVERS=b-1.fraud.xxxxxx.c2.kafka.eu-central-1.amazonaws.com:9096,b-2.fraud.xxxxxx.c2.kafka.eu-central-1.amazonaws.com:9096
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=fraud-platform
KAFKA_SASL_PASSWORD=<from Secrets Manager>

# S3 data lake and checkpoints (Spark image built with --build-arg WITH_S3=true)
LAKE_PATH=s3a://fraud-platform-lake-<account-id>/lake
CHECKPOINT_ROOT=s3a://fraud-platform-lake-<account-id>/checkpoints

# RDS PostgreSQL
POSTGRES_DSN=postgresql://fraud:<from Secrets Manager>@fraud-platform.xxxxxx.eu-central-1.rds.amazonaws.com:5432/fraud

# MLflow on ECS (service discovery)
MLFLOW_TRACKING_URI=http://mlflow.fraud-platform.local:5000
